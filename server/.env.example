# Server Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/walasmulla_tourist

# JWT secret - use a long random string in production (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Server port
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Admin seed credentials (used by npm run seed - do NOT use defaults in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@secure123!
